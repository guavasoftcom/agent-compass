# Agent Compass — backend environment template.
# Copy to .env. Two consumers read this file from backend/:
#
#   1. docker-compose.yml (auto-loaded) — interpolates POSTGRES_* values
#      into the Postgres service.
#   2. spring-boot-docker-compose — discovers the running container and
#      derives the JdbcConnectionDetails for the app, so the backend picks
#      up the same credentials without needing SPRING_DATASOURCE_* set.
#
# For non-Docker runs, set the SPRING_* vars at the bottom and either
# disable the compose support (spring.docker.compose.enabled=false) or
# remove the spring-boot-docker-compose dep.
#
# Load before running:
#   set -a; source .env; set +a
#   ./mvnw spring-boot:run

# --- Postgres (compose-driven) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coding_agent_tuning
POSTGRES_PORT=5432

# --- HTTP ---
SERVER_PORT=8080

# --- Hibernate ---
# Schema is owned by Flyway (src/main/resources/db/migration/V*.sql).
# Hibernate runs in "validate" mode: each @Entity must match the Flyway-managed
# tables on boot. Set to "none" to skip validation (e.g. on a read replica).
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# --- Tuning report config ---
# Which OTLP metric counts tool calls, and which attribute on that metric
# names the tool. Defaults match Claude Code's emitter; override if your
# agent emits something different.
TUNING_TOOL_DECISION_METRIC=claude_code.code_edit_tool.decision
TUNING_TOOL_ATTRIBUTE=tool

# --- Logging (optional) ---
# Uncomment to bump verbosity while debugging ingest.
# LOGGING_LEVEL_COM_GUAVASOFT_TELEMETRY=DEBUG

# --- Non-compose escape hatch ---
# Only needed when NOT using docker-compose (e.g. pointing the backend at
# an existing Postgres on a different host). When compose is running,
# spring-boot-docker-compose supplies these from the container — leave
# them blank.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/coding_agent_tuning
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=
